{
    "name": "wolves-web",
    "version": "0.0.0",
    "description": "",
    "main": "./src/index.tsx",
    "scripts": {
        "start": "brojs server --port=8099 --with-open-browser",
        "build": "npm run clean && brojs build --dev",
        "build:prod": "npm run clean && brojs build",
        "clean": "rimraf dist",
        "compile": "brojs compile",
        "prom": "npm run compile && brojs prom-server --port=8099",
        "lint": "oxlint --type-aware src",
        "lint:fix": "oxlint --type-aware --fix src",
        "typecheck": "tsc --noEmit",
        "format": "oxfmt src",
        "format:check": "oxfmt --check src"
    },
    "keywords": [],
    "type": "commonjs",
    "dependencies": {
        "@brojs/cli": "^2.0.1",
        "@types/react": "^18.3.31",
        "@types/react-dom": "^18.3.7",
        "express": "^4.22.3",
        "react": "^18.3.1",
        "react-dom": "^18.3.1"
    },
    "devDependencies": {
        "oxfmt": "^0.75.0",
        "oxlint": "^1.90.0",
        "oxlint-tsgolint": "^7.0.2005",
        "typescript": "^7.0.2"
    }
}
